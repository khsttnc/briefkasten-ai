# Briefkasten AI - frontend environment configuration
# Copy this file to frontend/.env and fill in real values.
# frontend/.env is gitignored and must never be committed.

# --- Supabase Auth ---
# Supabase Dashboard -> Project Settings -> API.
# VITE_SUPABASE_ANON_KEY is the "anon" "public" key - safe to expose in the
# browser. Never put the "service_role" key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
