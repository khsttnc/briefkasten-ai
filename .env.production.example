# Briefkasten AI - PRODUCTION environment configuration (briefkastenai.de)
#
# On the server: copy this file to backend/.env and fill in real values.
#   cp .env.production.example backend/.env
# backend/.env is gitignored and must never be committed. docker-compose.yml
# reads it via env_file - DATABASE_URL and UPLOAD_FOLDER are deliberately
# NOT set here, since docker-compose.yml already overrides both to point at
# the persistent db_data volume regardless of what this file says.

# --- AI provider selection ---
# Which AI provider to use: "claude", "ollama", or "nvidia".
AI_PROVIDER=nvidia

# --- Claude (Anthropic) provider ---
# Required only when AI_PROVIDER=claude. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional. Defaults to "claude-opus-5" if not set.
ANTHROPIC_MODEL=

# --- Ollama provider ---
# Required only when AI_PROVIDER=ollama. Not applicable in this deployment
# unless an Ollama instance is also reachable from the backend container.
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# --- NVIDIA NIM provider ---
# Required when AI_PROVIDER=nvidia. Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=
# Optional. Defaults to "nvidia/nemotron-3-nano-30b-a3b" if not set.
NVIDIA_MODEL=
# Optional. Defaults to https://integrate.api.nvidia.com/v1 if not set.
NVIDIA_BASE_URL=

# --- OCR ---
# Leave unset - the backend image installs tesseract-ocr on PATH
# (see backend/Dockerfile), which is what the Linux default already assumes.
TESSERACT_CMD=

# --- Storage / database ---
# Leave unset. docker-compose.yml sets DATABASE_URL and UPLOAD_FOLDER to
# paths inside the persistent db_data volume - setting them here would be
# silently overridden anyway (see docker-compose.yml's backend.environment).
DATABASE_URL=
UPLOAD_FOLDER=
# Optional. Maximum accepted upload size in megabytes. Defaults to 50.
MAX_UPLOAD_SIZE_MB=50

# --- Authentication (Supabase Auth) ---
# Required. Supabase Dashboard -> Settings -> API -> JWT Secret.
# Without this, all authenticated endpoints return 503.
SUPABASE_JWT_SECRET=

# --- CORS ---
# The real production frontend origin. Must be exactly this, no trailing
# slash, no /api suffix.
FRONTEND_ORIGIN=https://briefkastenai.de

# --- Stripe ---
# STRIPE_WEBHOOK_SECRET is required once the billing webhook is in use
# (Stripe Dashboard -> Webhooks -> the endpoint's "Signing secret").
# STRIPE_SECRET_KEY is not yet read anywhere in the codebase (reserved for
# a future subscription-creation flow) - safe to leave blank for now.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
