briefkastenai.de {
	# Security headers (security review finding: none of these existed
	# before - Caddy's auto-HTTPS handles TLS itself, but that's separate
	# from telling the browser to enforce it, and separate from
	# clickjacking/MIME-sniffing/CSP protection). Applies to every
	# response from this site block regardless of which handle below
	# serves it - harmless on the /api/* JSON responses (browsers only
	# enforce these in a rendered-document context) and load-bearing on
	# the frontend's HTML/JS.
	header {
		# Once a browser has loaded this site over HTTPS once, it will
		# refuse to try plain HTTP again for a year - closes the
		# downgrade window that auto-HTTPS alone leaves open (Caddy
		# still accepts and redirects a stray HTTP request; this tells
		# the browser to stop making one at all).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# This app renders real uploaded government/legal correspondence
		# - no third-party site should ever be able to frame it.
		X-Frame-Options "DENY"
		# Stop a browser from re-interpreting a response's declared
		# Content-Type.
		X-Content-Type-Options "nosniff"
		# Don't leak the full URL (which can embed a document id) to a
		# third-party site a user clicks through to.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Verified against the actual production build (`npm run build`
		# + inspecting dist/): no inline <script>/<style>, no eval/new
		# Function, only same-origin hashed assets, and the favicon is a
		# data: URI (hence img-src ... data:). connect-src additionally
		# allows Supabase's REST auth endpoints - the only external call
		# the browser itself makes; the AI provider and Stripe are only
		# ever called server-side, never from the browser. If new
		# frontend dependencies start requiring another origin (a CDN
		# font, an analytics script, etc.), this policy must be updated
		# to match - it is not meant to be loosened reflexively on a
		# console error, but re-verified against what the app actually
		# needs.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Explicitly opt out of browser features this app has no
		# legitimate use for.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Strip the /api prefix before forwarding, matching what the Vite dev
	# proxy does locally (see frontend/vite.config.ts) - the FastAPI routes
	# themselves have no /api prefix (see backend/app/main.py).
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
