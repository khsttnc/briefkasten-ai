# Briefkasten AI - backend environment configuration
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# --- AI provider selection ---
# Which AI provider to use: "claude", "ollama", or "nvidia". Defaults to "claude".
AI_PROVIDER=claude

# --- Claude (Anthropic) provider ---
# Required when AI_PROVIDER=claude. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional. Defaults to "claude-opus-5" if not set.
ANTHROPIC_MODEL=

# --- Ollama provider ---
# Required when AI_PROVIDER=ollama.
OLLAMA_MODEL=
# Optional. Defaults to http://localhost:11434 if not set.
OLLAMA_BASE_URL=

# --- NVIDIA NIM provider ---
# Required when AI_PROVIDER=nvidia. Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=
# Optional. Defaults to "nvidia/nemotron-3-nano-30b-a3b" if not set.
NVIDIA_MODEL=
# Optional. Defaults to https://integrate.api.nvidia.com/v1 if not set.
NVIDIA_BASE_URL=

# --- OCR ---
# Path to the Tesseract OCR executable. On Windows, defaults to the standard
# Tesseract-OCR install path. On Linux/macOS, defaults to "tesseract"
# (assumes it is available on PATH). Only set this if Tesseract is installed
# in a non-standard location.
TESSERACT_CMD=

# --- Storage / database ---
# Optional. Overrides the SQLAlchemy database URL.
# Defaults to a local SQLite file at backend/briefkasten.db.
DATABASE_URL=
# Optional. Overrides the directory used for uploaded files.
# Defaults to backend/uploads/.
UPLOAD_FOLDER=
# Optional. Maximum accepted upload size in megabytes. Defaults to 50.
MAX_UPLOAD_SIZE_MB=50

# --- Authentication (Supabase Auth) ---
# Required. Your project's base URL (Supabase Dashboard -> Settings -> API
# -> Project URL), e.g. https://xxxxx.supabase.co - used to fetch and
# verify against the project's JWKS endpoint
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json). Supabase signs user JWTs
# with an asymmetric key (ES256), not a shared secret, so there is no
# secret value to paste here. Without this, all authenticated endpoints
# return 503.
SUPABASE_URL=

# Required for the account self-deletion feature (DELETE /account) to
# delete the corresponding Supabase Auth user. Supabase Dashboard ->
# Project Settings -> API -> "service_role" "secret" key. This key bypasses
# Row Level Security entirely - keep it backend-only, NEVER as a VITE_
# variable or frontend build arg.
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS ---
# The single real frontend origin allowed to call this API. Defaults to the
# Vite dev server (http://localhost:5173) if not set. Must be overridden to
# the real production frontend URL in deployment.
FRONTEND_ORIGIN=

# --- Stripe ---
# STRIPE_SECRET_KEY is required for outbound Stripe API calls (currently:
# canceling a subscription during account self-deletion, see
# account_deletion.py). STRIPE_WEBHOOK_SECRET is required once the billing
# webhook is in use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
